# ==============================================================================
# AUREVIX — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit .env to version control.

# Python & Environment Lock
AUREVIX_ENV=development
AUREVIX_PROJECT_PYTHON_VERSION=3.12.x
AUREVIX_LOG_LEVEL=INFO
AUREVIX_STRUCTURED_LOGGING=false
AUREVIX_WORKSPACE=D:/Projects/aurevix

# Storage / Data Paths
AUREVIX_DATA_DIR=D:/Projects/aurevix/data
RAW_DATA_PATH=D:/Projects/aurevix/data/raw
BRONZE_DATA_PATH=D:/Projects/aurevix/data/bronze
SILVER_DATA_PATH=D:/Projects/aurevix/data/silver
GOLD_DATA_PATH=D:/Projects/aurevix/data/gold
QUARANTINE_DATA_PATH=D:/Projects/aurevix/data/quarantine
MONITORING_DATA_PATH=D:/Projects/aurevix/data/monitoring
CHECKPOINT_PATH=D:/Projects/aurevix/data/checkpoints

# Streaming Watermark Configuration
WATERMARK_DELAY_MINUTES=10

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aurevix_dw
POSTGRES_USER=aurevix_admin
POSTGRES_PASSWORD=aurevix_secure_password_change_me
POSTGRES_SCHEMA_GOLD=gold
POSTGRES_SCHEMA_MONITORING=monitoring

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_ORDERS=aurevix.retail.orders
KAFKA_CONSUMER_GROUP=aurevix-stream-processors

# Apache Spark Configuration
SPARK_APP_NAME=AUREVIX-Engine
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=4

# Apache Airflow Configuration
AIRFLOW_HOME=D:/Projects/aurevix/airflow
AIRFLOW_WEBSERVER_PORT=8080

# Streamlit Dashboard Configuration
STREAMLIT_PORT=8501

# SLA & Freshness Thresholds
SLA_MAX_LATENCY_MINUTES=60
SLA_MAX_QUARANTINE_PERCENT=1.0
